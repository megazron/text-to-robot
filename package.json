{
  "name": "text-to-robot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "cli"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "api": "node apps/api/src/server.ts",
    "cli": "node cli/src/index.ts",
    "physics-check": "python3 scripts/physics_check.py"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2"
  }
}
