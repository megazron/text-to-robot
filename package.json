{
  "name": "text-to-robot",
  "version": "0.7.0",
  "private": true,
  "description": "Describe a robot in plain words. Get one you can simulate, wire and print: real parts, printable housings, wiring, ROS 2 and a physics report.",
  "keywords": [
    "robotics",
    "text-to-robot",
    "urdf",
    "ros2",
    "robot-design",
    "moveit",
    "mujoco",
    "3d-printing",
    "bom",
    "arduino",
    "cad"
  ],
  "homepage": "https://megazron.github.io/text-to-robot/",
  "bugs": {
    "url": "https://github.com/megazron/text-to-robot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megazron/text-to-robot.git"
  },
  "license": "MIT",
  "author": "megazron",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "cli"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "node --test --test-force-exit --test-timeout=1200000 tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint",
    "api": "node apps/api/src/server.ts",
    "cli": "node cli/src/index.ts",
    "physics-check": "python3 scripts/physics_check.py",
    "postinstall": "node scripts/vendor_web.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/earcut": "3.0.0",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "avr8js": "0.21.1"
  }
}
