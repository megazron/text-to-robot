<?xml version="1.0"?>
<robot name="eva">
  <group name="left_arm">
    <chain base_link="body" tip_link="left_hand"/>
  </group>
  <group_state name="home" group="left_arm">
    <joint name="left_shoulder_joint" value="0"/>
    <joint name="left_arm_roll" value="0"/>
  </group_state>
  <group name="right_arm">
    <chain base_link="body" tip_link="right_hand"/>
  </group>
  <group_state name="home" group="right_arm">
    <joint name="right_shoulder_joint" value="0"/>
    <joint name="right_arm_roll" value="0"/>
  </group_state>
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="body"/>
  <disable_collisions link1="body" link2="head" reason="Adjacent"/>
  <disable_collisions link1="head" link2="visor" reason="Adjacent"/>
  <disable_collisions link1="body" link2="left_arm" reason="Adjacent"/>
  <disable_collisions link1="left_arm" link2="left_hand" reason="Adjacent"/>
  <disable_collisions link1="body" link2="right_arm" reason="Adjacent"/>
  <disable_collisions link1="right_arm" link2="right_hand" reason="Adjacent"/>
  <disable_collisions link1="body" link2="hover_thruster" reason="Adjacent"/>
</robot>
