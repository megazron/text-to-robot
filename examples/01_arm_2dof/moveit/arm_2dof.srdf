<?xml version="1.0"?>
<robot name="arm_2dof">
  <group name="arm">
    <chain base_link="base_link" tip_link="upper_arm"/>
  </group>
  <group_state name="home" group="arm">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="0"/>
  </group_state>
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link"/>
  <disable_collisions link1="base_link" link2="shoulder" reason="Adjacent"/>
  <disable_collisions link1="shoulder" link2="upper_arm" reason="Adjacent"/>
  <disable_collisions link1="upper_arm" link2="gripper_base" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="left_finger" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="right_finger" reason="Adjacent"/>
</robot>
