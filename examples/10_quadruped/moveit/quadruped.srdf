<?xml version="1.0"?>
<robot name="quadruped">
  <group name="front_left_leg">
    <chain base_link="base_link" tip_link="front_left_shin"/>
  </group>
  <group_state name="home" group="front_left_leg">
    <joint name="front_left_hip_joint" value="0"/>
    <joint name="front_left_thigh_joint" value="0"/>
    <joint name="front_left_knee_joint" value="0"/>
  </group_state>
  <group name="front_right_leg">
    <chain base_link="base_link" tip_link="front_right_shin"/>
  </group>
  <group_state name="home" group="front_right_leg">
    <joint name="front_right_hip_joint" value="0"/>
    <joint name="front_right_thigh_joint" value="0"/>
    <joint name="front_right_knee_joint" value="0"/>
  </group_state>
  <group name="rear_left_leg">
    <chain base_link="base_link" tip_link="rear_left_shin"/>
  </group>
  <group_state name="home" group="rear_left_leg">
    <joint name="rear_left_hip_joint" value="0"/>
    <joint name="rear_left_thigh_joint" value="0"/>
    <joint name="rear_left_knee_joint" value="0"/>
  </group_state>
  <group name="rear_right_leg">
    <chain base_link="base_link" tip_link="rear_right_shin"/>
  </group>
  <group_state name="home" group="rear_right_leg">
    <joint name="rear_right_hip_joint" value="0"/>
    <joint name="rear_right_thigh_joint" value="0"/>
    <joint name="rear_right_knee_joint" value="0"/>
  </group_state>
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link"/>
  <disable_collisions link1="base_link" link2="front_left_hip" reason="Adjacent"/>
  <disable_collisions link1="front_left_hip" link2="front_left_thigh" reason="Adjacent"/>
  <disable_collisions link1="front_left_thigh" link2="front_left_shin" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="front_right_hip" reason="Adjacent"/>
  <disable_collisions link1="front_right_hip" link2="front_right_thigh" reason="Adjacent"/>
  <disable_collisions link1="front_right_thigh" link2="front_right_shin" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="rear_left_hip" reason="Adjacent"/>
  <disable_collisions link1="rear_left_hip" link2="rear_left_thigh" reason="Adjacent"/>
  <disable_collisions link1="rear_left_thigh" link2="rear_left_shin" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="rear_right_hip" reason="Adjacent"/>
  <disable_collisions link1="rear_right_hip" link2="rear_right_thigh" reason="Adjacent"/>
  <disable_collisions link1="rear_right_thigh" link2="rear_right_shin" reason="Adjacent"/>
</robot>
